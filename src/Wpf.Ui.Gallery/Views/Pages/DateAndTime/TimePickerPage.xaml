<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.DateAndTime.TimePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.DateAndTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TimePickerPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:TimePicker}"
    d:DataContext="{d:DesignInstance local:TimePickerPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="WPF UI TimePicker."
            XamlCode="&lt;ui:TimePicker ClockIdentifier=&quot;Clock12Hour&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TimePicker
                    x:Name="TwelveHourTimePicker"
                    Grid.Column="0"
                    Width="300"
                    ClockIdentifier="Clock12Hour" />
                <ui:TextBlock
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    Text="{Binding ElementName=TwelveHourTimePicker, Path=SelectedTime}" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="A 24-hour picker stepping through quarter hours."
            XamlCode="&lt;ui:TimePicker ClockIdentifier=&quot;Clock24Hour&quot; MinuteIncrement=&quot;15&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TimePicker
                    x:Name="TwentyFourHourTimePicker"
                    Grid.Column="0"
                    Width="300"
                    ClockIdentifier="Clock24Hour"
                    MinuteIncrement="15" />
                <ui:TextBlock
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    Text="{Binding ElementName=TwentyFourHourTimePicker, Path=SelectedTime}" />
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
